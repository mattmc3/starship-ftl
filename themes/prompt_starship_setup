#!/usr/bin/env zsh
#
# prompt_starship_setup: Use starship with the built-in Zsh prompt system conventions.
#

#function prompt_starship_setup {

(( $+commands[starship] )) || {
  print -ru2 -- "prompt_starship_setup: starship command not found"
  return 1
}

# When loaded through the prompt command, these prompt_* options will be enabled
prompt_opts=(cr percent sp subst)

# Set the starship config based on an argument if one is provided. The lookup
# lives in ftl-starship.zsh so ftl-prompt can resolve the same config before the
# theme loads, which is what `ftl-prompt -P` renders against.
if [[ -n "$1" ]]; then
  # Sourced already when this repo's ftl-prompt.zsh is in play, so this is for
  # the theme used on its own. %x, not %N: autoloaded, %N is the function name.
  0=${(%):-%x}
  (( $+functions[_ftl_starship_config] )) || source ${0:A:h:h}/ftl-starship.zsh
  _ftl_starship_config "$1"
fi

# starship's init sets PROMPT2 from a command substitution, spawning starship a
# second time. Write the value in literally instead. A starship that stops
# emitting that line is left alone, and just keeps the spawn.
_ftl_starship_init() {
  local init continuation
  init=$(starship init zsh) || return 1
  continuation=$(starship prompt --continuation)
  print -r -- ${init/PROMPT2=\"\$(*)\"/PROMPT2=${(qqq)continuation}}
}

# Sourced out here, not in a helper: the init sets options that have to reach
# the shell. No cache when this theme is used on its own, so fall back to live.
if (( $+functions[_ftl_cache_file] )) &&
   _ftl_cache_file starship-init _ftl_starship_init; then
  source $REPLY
else
  source <(starship init zsh)
fi

