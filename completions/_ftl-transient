#compdef ftl-transient

local -a commands
commands=(
  'on:draw a short prompt on finished command lines'
  'off:go back to the full prompt everywhere'
)

if (( CURRENT == 2 )); then
  _describe -t commands 'ftl-transient command' commands
  return
fi

# `on` takes an optional starship profile name. Offer the ones the user's
# starship.toml actually defines rather than a hardcoded "transient".
if [[ $words[2] == on ]] && (( CURRENT == 3 )); then
  local -a profiles
  if (( $+functions[_ftl_transient_profile_names] )); then
    profiles=(${(f)"$(_ftl_transient_profile_names)"})
  fi
  if (( $#profiles )); then
    _describe -t profiles 'starship profile' profiles
  else
    _message 'no [profiles] in starship.toml'
  fi
  return
fi

return 1
